# ── Where the money goes ─────────────────────────────────────────────────────
# Both rails ship pre-filled with the x402 Suite's public receive addresses, so
# the service runs out of the box. Change them to YOUR addresses to get paid.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ── Networks ─────────────────────────────────────────────────────────────────
# EVM rail: base-sepolia (default, testnet) or base (mainnet).
NETWORK=base-sepolia
# Solana rail: mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta

# ── Facilitators (verify + settle) ───────────────────────────────────────────
#   x402.org           → base-sepolia, solana-devnet   (free, testnet)
#   facilitator.payai  → base, base-sepolia, solana    (free, no API key)
FACILITATOR_URL=https://x402.org/facilitator
SOLANA_FACILITATOR_URL=https://facilitator.payai.network

# ── Flows ────────────────────────────────────────────────────────────────────
# Directory of YAML flow definitions. Every valid flow becomes a priced route
# at POST /run/<name>, using the price declared in its own file.
FLOWS_DIR=flows

# Hosts EVERY flow may reach, in addition to its own `allowHosts` list.
# Leave this empty unless you know why you're widening it — a flow's allowlist
# is the security boundary that stops a stray click leaving the target site.
# EXTRA_ALLOW_HOSTS=

# ── Browser ──────────────────────────────────────────────────────────────────
# `false` shows the browser window. Debugging only; never in production.
HEADLESS=true
# Use a system Chromium instead of Puppeteer's bundled download. Handy in
# containers (`apt-get install chromium`) and required on some hosts.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Signing ──────────────────────────────────────────────────────────────────
# Secret for the HMAC-SHA256 signatures on run records. A dev default is used
# when unset — ALWAYS set your own, or a run record proves nothing.
# SIGNING_SECRET=change-me

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4034
# Public origin. Used BOTH for the 402 `resource` field and to resolve
# {{baseUrl}} in flows, so set it when running behind a proxy.
# PUBLIC_BASE_URL=https://bridge.example.com

# ── Client example (examples/agent-client.ts) ────────────────────────────────
# Funded base-sepolia wallet the example agent pays with.
# PRIVATE_KEY=0x...
# BASE_URL=http://localhost:4034
