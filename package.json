{
  "name": "x402-browser-bridge",
  "version": "0.1.0",
  "description": "Framework that turns any website flow into an x402-paid API — declare a flow in YAML, Puppeteer executes, artifact returned in-response",
  "type": "module",
  "license": "Apache-2.0",
  "author": "nirholas <nichxbt@gmail.com>",
  "repository": { "type": "git", "url": "https://github.com/nirholas/x402-browser-bridge" },
  "homepage": "https://nirholas.github.io/x402-browser-bridge/",
  "keywords": [
    "x402", "micropayments", "usdc", "solana", "base", "ai-agents",
    "agentic-commerce", "puppeteer", "browser-automation", "yaml", "web-automation"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "flows", "skill.md", "README.md", "LICENSE"],
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "client": "tsx examples/agent-client.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@three-ws/x402-payment-modal": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "puppeteer": "^24.0.0",
    "viem": "^2.21.0",
    "x402": "^1.2.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "x402-fetch": "^1.2.0"
  },
  "engines": { "node": ">=18" }
}
